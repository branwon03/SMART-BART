FROM node:20-slim

RUN apt-get update && apt-get install -y curl git qrencode && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY src/mobile/package*.json ./
RUN npm install
RUN npm install -g @expo/ngrok@^4.1.0

COPY src/mobile/ ./
COPY start-mobile.sh ./
RUN chmod +x start-mobile.sh

EXPOSE 8081 19000 19001 19002

CMD ["sh", "start-mobile.sh"]